    "A lightweight WebSocket server that routes messages between your iPhone and your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lightweight WebSocket server that routes messages between your iPhone and your device."
