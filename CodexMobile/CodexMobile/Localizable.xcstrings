          }
        }
      }
    },
    "The bridge spawns a **`codex app-server`** process — the same JSON-RPC interface behind the Codex desktop app and IDE extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge spawns a **`codex app-server`** process — the same JSON-RPC interface behind the Codex desktop app and IDE extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge 启动 **`codex app-server`** 进程，使用与 Codex 桌面应用和 IDE 扩展相同的 JSON-RPC 接口。"
          }
        }
      }
    },
    "The bridge's identity public key": {
      "extractionState": "manual",
      "localizations": {
