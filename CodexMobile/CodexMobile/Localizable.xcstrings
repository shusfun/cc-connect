        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备 Bridge 拒绝更新此设置。"
          }
        }
      }
    },
    "The first connection may ask you to trust the host key. Accept only when the computer is the one you intended. If you change machines later, reset the saved host key in the connection editor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first connection may ask you to trust the host key. Accept only when the computer is the one you intended. If you change machines later, reset the saved host key in the connection editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次连接可能要求信任主机密钥，仅在核实目标设备后接受。换机时需在连接编辑器中重新核验并重置主机密钥。"
          }
        }
      }
    },
    "The fork request may already have reached the runtime. The new worktree was kept until sync confirms whether the new chat exists.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fork request may already have reached the runtime. The new worktree was kept until sync confirms whether the new chat exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分叉请求可能已送达运行时，已保留新工作树，等待同步确认任务是否创建。"
          }
        }
      }
    },
    "The handoff destination already has uncommitted changes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handoff destination already has uncommitted changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移交目标已有未提交修改。"
          }
        }
