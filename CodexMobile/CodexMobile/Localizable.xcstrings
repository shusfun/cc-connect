    },
    "The handoff destination is no longer available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The handoff destination is no longer available on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的移交目标已不可用。"
          }
        }
      }
    },
    "The initial pairing metadata is missing the device identity key. Scan a new QR code to reconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The initial pairing metadata is missing the device identity key. Scan a new QR code to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始配对信息缺少设备身份密钥，请扫描新二维码。"
          }
        }
      }
    },
    "The managed worktree is no longer available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The managed worktree is no longer available on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的受管理工作树已不可用。"
          }
        }
      }
    },
    "The moved changes were kept in the temporary worktree because the original checkout could not be restored automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moved changes were kept in the temporary worktree because the original checkout could not be restored automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原工作副本无法自动恢复，已将移动的修改保留在临时工作树中。"
          }
        }
      }
    },
    "The new worktree was kept in case the chat was already created. Wait a moment, then check your thread list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new worktree was kept in case the chat was already created. Wait a moment, then check your thread list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务可能已创建，因此保留了新工作树，请稍后检查任务列表。"
          }
        }
      }
    },
    "The new worktree was kept in case the fork already exists. Wait a moment for sync, then check your thread list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new worktree was kept in case the fork already exists. Wait a moment for sync, then check your thread list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分叉可能已创建，因此保留了新工作树，请等待同步后检查任务列表。"
          }
        }
      }
    },
    "The next connection to this host will trust the key it presents.": {
