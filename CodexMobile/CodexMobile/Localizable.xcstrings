            "state": "translated",
            "value": "设备 Bridge 的身份公钥"
          }
        }
      }
    },
    "The connection dropped after the chat request was sent, so the new worktree was kept in case the chat still appears after sync.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped after the chat request was sent, so the new worktree was kept in case the chat still appears after sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务请求发送后连接中断，已保留新工作树，避免删除同步后可能出现的任务。"
          }
        }
      }
    },
    "The connection dropped after the fork request was sent, so the new thread may still appear once the runtime syncs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
