          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务数据超出中继连接的大小限制。重新打开包含大量图片的任务时，即使未发送消息也可能出现此问题。"
          }
        }
      }
    },
