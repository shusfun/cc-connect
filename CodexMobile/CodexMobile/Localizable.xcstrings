    "SSH connection closed before the terminal was ready. Check that Remote Login is enabled on the Mac and retry. If this Mac was restored or reinstalled, reset the terminal host key first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
