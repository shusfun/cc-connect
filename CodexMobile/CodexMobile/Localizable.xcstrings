    },
    "The bridge forwards it to `codex app-server` via JSON-RPC": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge forwards it to `codex app-server` via JSON-RPC"
          }
        },
