          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 与设备之间转发消息的轻量 WebSocket 服务。"
          }
        }
      }
    },
    "A new Remodex icon and unified visual identity, plus an SF Pro Rounded font option.": {
      "extractionState": "manual",
