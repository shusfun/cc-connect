    "The paired device was temporarily unavailable and this message could not be delivered. Wait a moment, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paired device was temporarily unavailable and this message could not be delivered. Wait a moment, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对设备暂时不可用，消息未能送达，请稍后重试。"
          }
        }
      }
    },
    "The paired device will be removed from this iPhone. Scan its QR code again to reconnect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paired device will be removed from this iPhone. Scan its QR code again to reconnect."
          }
        },
