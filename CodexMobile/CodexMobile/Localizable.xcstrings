    },
    "The Codex runtime stays on your device. Your phone is a secure remote control connected through a relay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Codex runtime stays on your device. Your phone is a secure remote control connected through a relay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 始终运行在你的设备上，手机通过中继进行安全远程操作。"
          }
        }
      }
    },
    "The Mac is not reachable from this network. Check that the iPhone and Mac are on the same network and that the saved host/IP is still current.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac is not reachable from this network. Check that the iPhone and Mac are on the same network and that the saved host/IP is still current."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前网络无法访问设备，请检查手机与设备的网络，以及保存的主机地址。"
          }
        }
      }
    },
    "The Mac refused the SSH connection. Enable Remote Login on the Mac and confirm the terminal port is correct.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
