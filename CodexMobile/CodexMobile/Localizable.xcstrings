          "stringUnit": {
            "state": "translated",
            "value": "Bridge 通过 JSON-RPC 将消息转发给 `codex app-server`"
          }
        }
      }
    },
    "The bridge handles **git commands** from your phone locally on the paired device:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge handles **git commands** from your phone locally on the paired device:"
